# Plantilla de referencia. Los valores reales se cargan en Environment de
# EasyPanel; no crees ni subas un archivo .env al repositorio.
APP_BASE_URL=https://crm.ejemplo.com
DATABASE_URL=postgresql://REEMPLAZA_usuario:REEMPLAZA_password@REEMPLAZA_host_interno:5432/REEMPLAZA_base
BETTER_AUTH_SECRET=REEMPLAZA_secreto_de_sesiones
ENCRYPTION_KEY=REEMPLAZA_32_bytes_en_base64
META_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_de_webhook
META_APP_SECRET=REEMPLAZA_meta_app_secret
META_GRAPH_API_VERSION=v25.0

# Opcionales: deja sin definir en EasyPanel cuando no se usen.
AGENT_COALESCE_MS=6000
